{
  "$schema": "https://schemas.designtokens.org/2025-10-01/draft.json",
  "$description": "Writing pillar — primitive layer. Objective, measurable craft constants sourced from project-editorial's house-core.md (the shared craft foundation beneath all five register guides). Tenant-agnostic — applies to every register, every profile, every tenant. The register/lexicon/disclaimer rule shapes in writing/semantic.json compose over these; tenant-specific vocabulary and legal-entity values live in a per-brand media-assets override (e.g. woodfine-media-assets), never here.",
  "writing": {
    "primitive": {
      "table": {
        "$type": "dimension",
        "$description": "Wiki-article table geometry — promoted 2026-09-08 from app-mediakit-knowledge/static/tokens.css's --k-table-* CSS custom properties (live, working values — zebra striping, scroll-wrap, never-reflow behavior verified against real Wikipedia table conventions, BRIEF-wiki-infobox-table-tokens.md). Distinct from paper.primitive.table (print/legal document tables — different context, confirmed no overlap) and from writing.primitive.rhythm's prose typography (tables intentionally use a smaller font-size than running prose, matching real Wikipedia convention).",
        "font-size": {
          "$value": "0.9375rem",
          "$extensions": {
            "com.pointsav.tokens": {
              "id": "--ps-writing-primitive-table-font-size",
              "pillar": "writing",
              "layer": "primitive",
              "family": "table",
              "schemaVersion": 1
            }
          }
        },
        "cell-pad-x": {
          "$value": "0.7rem",
          "$extensions": {
            "com.pointsav.tokens": {
              "id": "--ps-writing-primitive-table-cell-pad-x",
              "pillar": "writing",
              "layer": "primitive",
              "family": "table",
              "schemaVersion": 1
            }
          }
        },
        "cell-pad-y": {
          "$value": "0.45rem",
          "$extensions": {
            "com.pointsav.tokens": {
              "id": "--ps-writing-primitive-table-cell-pad-y",
              "pillar": "writing",
              "layer": "primitive",
              "family": "table",
              "schemaVersion": 1
            }
          }
        }
      },
      "rhythm": {
        "$type": "number",
        "sentence-avg-words": {
          "$value": 18,
          "$description": "House target sentence length — 15-20 word band",
          "$extensions": {
            "com.pointsav.tokens": {
              "id": "--ps-writing-primitive-rhythm-sentence-avg-words",
              "pillar": "writing",
              "layer": "primitive",
              "family": "rhythm",
              "schemaVersion": 1
            }
          }
        },
        "sentence-fact-of-record-max": {
          "$value": 25,
          "$description": "Ceiling for a definition/compliance/legal claim sentence — a target, not a hard gate",
          "$extensions": {
            "com.pointsav.tokens": {
              "id": "--ps-writing-primitive-rhythm-sentence-fact-of-record-max",
              "pillar": "writing",
              "layer": "primitive",
              "family": "rhythm",
              "schemaVersion": 1
            }
          }
        },
        "paragraph-line-min": {
          "$value": 3,
          "$extensions": {
            "com.pointsav.tokens": {
              "id": "--ps-writing-primitive-rhythm-paragraph-line-min",
              "pillar": "writing",
              "layer": "primitive",
              "family": "rhythm",
              "schemaVersion": 1
            }
          }
        },
        "paragraph-line-max": {
          "$value": 7,
          "$description": "Past this a paragraph usually carries two ideas",
          "$extensions": {
            "com.pointsav.tokens": {
              "id": "--ps-writing-primitive-rhythm-paragraph-line-max",
              "pillar": "writing",
              "layer": "primitive",
              "family": "rhythm",
              "schemaVersion": 1
            }
          }
        },
        "heading-density-words": {
          "$value": 130,
          "$description": "Roughly one heading per 120-140 body words",
          "$extensions": {
            "com.pointsav.tokens": {
              "id": "--ps-writing-primitive-rhythm-heading-density-words",
              "pillar": "writing",
              "layer": "primitive",
              "family": "rhythm",
              "schemaVersion": 1
            }
          }
        },
        "lead-words-min": {
          "$value": 100,
          "$extensions": {
            "com.pointsav.tokens": {
              "id": "--ps-writing-primitive-rhythm-lead-words-min",
              "pillar": "writing",
              "layer": "primitive",
              "family": "rhythm",
              "schemaVersion": 1
            }
          }
        },
        "lead-words-max": {
          "$value": 400,
          "$extensions": {
            "com.pointsav.tokens": {
              "id": "--ps-writing-primitive-rhythm-lead-words-max",
              "pillar": "writing",
              "layer": "primitive",
              "family": "rhythm",
              "schemaVersion": 1
            }
          }
        }
      },
      "casing": {
        "$type": "string",
        "title": {
          "$value": "sentence-case-keyword-first",
          "$description": "Capitalize the first word plus proper nouns/acronyms/code identifiers only",
          "$extensions": {
            "com.pointsav.tokens": {
              "id": "--ps-writing-primitive-casing-title",
              "pillar": "writing",
              "layer": "primitive",
              "family": "casing",
              "schemaVersion": 1
            }
          }
        },
        "heading": {
          "$value": "sentence-case-keyword-first",
          "$extensions": {
            "com.pointsav.tokens": {
              "id": "--ps-writing-primitive-casing-heading",
              "pillar": "writing",
              "layer": "primitive",
              "family": "casing",
              "schemaVersion": 1
            }
          }
        },
        "slug": {
          "$value": "lowercase-kebab",
          "$extensions": {
            "com.pointsav.tokens": {
              "id": "--ps-writing-primitive-casing-slug",
              "pillar": "writing",
              "layer": "primitive",
              "family": "casing",
              "schemaVersion": 1
            }
          }
        },
        "leading-article": {
          "$value": "forbidden",
          "$description": "No title, heading, or slug begins with the/a/an",
          "$extensions": {
            "com.pointsav.tokens": {
              "id": "--ps-writing-primitive-casing-leading-article",
              "pillar": "writing",
              "layer": "primitive",
              "family": "casing",
              "schemaVersion": 1
            }
          }
        }
      },
      "voice": {
        "$type": "string",
        "default": {
          "$value": "active",
          "$description": "Name the actor and the consequence",
          "$extensions": {
            "com.pointsav.tokens": {
              "id": "--ps-writing-primitive-voice-default",
              "pillar": "writing",
              "layer": "primitive",
              "family": "voice",
              "schemaVersion": 1
            }
          }
        },
        "forward-looking": {
          "$value": "planned|intended|may|target",
          "$description": "Not-yet-true capabilities wear their status visibly — the BCSC disclosure posture",
          "$extensions": {
            "com.pointsav.tokens": {
              "id": "--ps-writing-primitive-voice-forward-looking",
              "pillar": "writing",
              "layer": "primitive",
              "family": "voice",
              "schemaVersion": 1
            }
          }
        },
        "credibility": {
          "$value": "mechanism-number-verifiable-claim",
          "$description": "Never borrow a named institution for prestige",
          "$extensions": {
            "com.pointsav.tokens": {
              "id": "--ps-writing-primitive-voice-credibility",
              "pillar": "writing",
              "layer": "primitive",
              "family": "voice",
              "schemaVersion": 1
            }
          }
        },
        "concrete-word": {
          "$value": "prefer-concrete-over-abstract",
          "$description": "use>utilize; end>terminate; explain>elucidate; named-number>vague-quantifier",
          "$extensions": {
            "com.pointsav.tokens": {
              "id": "--ps-writing-primitive-voice-concrete-word",
              "pillar": "writing",
              "layer": "primitive",
              "family": "voice",
              "schemaVersion": 1
            }
          }
        }
      },
      "loop": {
        "$type": "string",
        "standard": {
          "$value": "draft-improves-draft",
          "$description": "Each revision pass sets up a clearly better next pass; revise one altitude per pass, top-down",
          "$extensions": {
            "com.pointsav.tokens": {
              "id": "--ps-writing-primitive-loop-standard",
              "pillar": "writing",
              "layer": "primitive",
              "family": "loop",
              "schemaVersion": 1
            }
          }
        }
      }
    }
  }
}
